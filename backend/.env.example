# ====================================================================
# NER Disaster Logistics & Response Intelligence Platform
# Backend Environment Configuration
# ====================================================================

# Port (Optional: defaults to 8000 locally or platform-assigned $PORT in cloud)
PORT=8000

# Application & Security Settings
PROJECT_NAME="AI-Powered Disaster Logistics & Response Coordination Platform"
API_V1_STR=/api/v1
SECRET_KEY=DISASTER_COORDINATION_SECURE_JWT_SECRET_2026_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Custom Data Directory (Optional: auto-detected if omitted)
# DATA_DIR=./data

# 1. AI Copilot - Google Gemini Configuration (Recommended)
# Get your API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Alternative LLM - OpenAI / ChatGPT (Optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
