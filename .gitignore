# ====================================================================
# NER Disaster Logistics & Response Intelligence Platform - .gitignore
# ====================================================================

# 1. Environment & Secret Keys (NEVER commit secrets to Git)
.env
.env.*
*.env
!.env.example
!*.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# 2. Node & Frontend Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
build/
*.local

# 3. Python & Backend Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Testing, Linting & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
*.cover
*.py,cover
.hypothesis/
.oxlint-cache

# 5. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 6. IDE & Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.sublime-workspace
*.sublime-project

# 7. Logs & Temporary Files
logs/
*.log
scratch/
.temp/
*.tmp
